# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# --- Supabase ---
# Project URL and anon key are safe for client-side use.
# SERVICE_ROLE key is server-side only — bypasses row-level security,
# never expose it in client code or commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Sheets (service account, server-side pull) ---
# Share the target Sheet with this service account's email, or the pull
# will fail with a permissions error despite correct credentials.
# Roster Sheet: share as Viewer. Attendance Sheet: share as Editor — Take
# Attendance writes marks back into it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_ROSTER_SPREADSHEET_ID=
GOOGLE_SHEETS_ATTENDANCE_SPREADSHEET_ID=

# --- Claude API ---
ANTHROPIC_API_KEY=

# --- This team ---
# Sport, as a lowercase slug (e.g. ultimate, field-hockey). Used in the AI
# prompts and to load documentation/AI sport knowledge/<sport>.md if that
# file exists. Unset: the AI is told "sports teams" and gets no reference.
COACHMATE_SPORT=
# IANA time zone of the team (e.g. Europe/Berlin). Decides "today", the
# briefing week and displayed times. Unset or unknown: UTC.
COACHMATE_TIME_ZONE=

# --- Twilio WhatsApp Sandbox ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Optional: the exact webhook URL set in the Twilio console. Signatures are
# checked against it; defaults to the request URL.
TWILIO_WEBHOOK_URL=

# --- App access gate ---
# Single shared password, checked in middleware. Not a user account
# system — see CLAUDE.md Current Scope Boundaries.
APP_SHARED_PASSWORD=

# --- Cron ---
# Random secret (e.g. `openssl rand -hex 32`). Vercel Cron sends it as a
# Bearer token to /api/cron/retention, the daily check-in and expired-
# draft deletion job.
# If unset, the job refuses every request.
CRON_SECRET=
